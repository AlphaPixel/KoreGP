+/* dma-buf sharing between opens of the shim device.  The "dma-buf" is a
+ * memfd of the BO's size whose inode number names the BO.  The reference
+ * taken at export is never dropped, which is fine for a shim.
+ */
+static struct hash_table_u64 *prime_bos;
+
+static int
+drm_shim_ioctl_prime_handle_to_fd(int fd, unsigned long request, void *arg)
+{
+   struct shim_fd *shim_fd = drm_shim_fd_lookup(fd);
+   struct drm_prime_handle *p = arg;
+   struct stat st;
+
+   struct shim_bo *bo = drm_shim_bo_lookup(shim_fd, p->handle);
+   if (!bo)
+      return -ENOENT;
+
+   int buf_fd = memfd_create("shim dma-buf", MFD_CLOEXEC);
+   if (buf_fd < 0 || ftruncate(buf_fd, bo->size) != 0 ||
+       fstat(buf_fd, &st) != 0) {
+      if (buf_fd >= 0)
+         close(buf_fd);
+      drm_shim_bo_put(bo);
+      return -ENOMEM;
+   }
+
+   mtx_lock(&shim_device.lock);
+   if (!prime_bos)
+      prime_bos = _mesa_hash_table_u64_create(NULL);
+   _mesa_hash_table_u64_insert(prime_bos, st.st_ino, bo);
+   mtx_unlock(&shim_device.lock);
+
+   p->fd = buf_fd;
+   return 0;
+}
+
+static int
+drm_shim_ioctl_prime_fd_to_handle(int fd, unsigned long request, void *arg)
+{
+   struct shim_fd *shim_fd = drm_shim_fd_lookup(fd);
+   struct drm_prime_handle *p = arg;
+   struct stat st;
+
+   if (fstat(p->fd, &st) != 0)
+      return -EBADF;
+
+   mtx_lock(&shim_device.lock);
+   struct shim_bo *bo =
+      prime_bos ? _mesa_hash_table_u64_search(prime_bos, st.st_ino) : NULL;
+   mtx_unlock(&shim_device.lock);
+   if (!bo)
+      return -EINVAL;
+
+   /* As the kernel does: one handle per BO and file. */
+   mtx_lock(&shim_fd->handle_lock);
+   hash_table_foreach(shim_fd->handles, entry) {
+      if (entry->data == bo) {
+         p->handle = (uintptr_t)entry->key;
+         mtx_unlock(&shim_fd->handle_lock);
+         return 0;
+      }
+   }
+   mtx_unlock(&shim_fd->handle_lock);
+
+   p->handle = drm_shim_bo_get_handle(shim_fd, bo);
+   return 0;
+}
+
