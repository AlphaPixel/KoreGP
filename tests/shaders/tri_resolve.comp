#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

// The "msaa" variant's readback (tri_scene.h): KoreGP has no resolve call,
// a resolve is a shader. Averages the samples of each pixel of the
// multisampled texture at heap index 0 and writes it, packed, to plain
// memory.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2DMS kgpTextures[];

layout(buffer_reference, scalar) buffer UintArray { uint v[]; };

layout(buffer_reference, scalar) readonly buffer TriResolveRoot {
   UintArray dst;
   uint width;
   uint samples;
};

layout(push_constant, scalar) uniform Push { TriResolveRoot root; };

void main()
{
   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
   vec4 sum = vec4(0.0);
   for (uint s = 0; s < root.samples; s++)
      sum += texelFetch(kgpTextures[0], p, int(s));
   root.dst.v[p.y * int(root.width) + p.x] =
      packUnorm4x8(sum / float(root.samples));
}
