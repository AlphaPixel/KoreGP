#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

// A benchmark shader whose time is arithmetic on root fields, not memory
// traffic: each thread runs a polynomial recurrence `iters` times with
// eight coefficients read from the root struct, and stores one float.
// For comparing the two root conventions (plan task N1.H): under v0 the
// coefficients are loads through the root pointer, under v1 they are
// constant-buffer operands.

layout(local_size_x = 64) in;

layout(buffer_reference, scalar) buffer FloatArray { float v[]; };

layout(buffer_reference, scalar) readonly buffer RootLoopRoot {
   FloatArray dst;
   uint count;
   uint iters;
   float c[8];
};

layout(push_constant, scalar) uniform Push { RootLoopRoot root; };

void main()
{
   uint i = gl_GlobalInvocationID.x;
   if (i >= root.count)
      return;

   float x = float(i) * (1.0 / 16777216.0);
   for (uint k = 0; k < root.iters; k++) {
      x = x * root.c[0] + root.c[1];
      x = x * root.c[2] + root.c[3];
      x = x * root.c[4] + root.c[5];
      x = x * root.c[6] + root.c[7];
   }
   root.dst.v[i] = x;
}
