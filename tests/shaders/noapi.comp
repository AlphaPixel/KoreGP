#version 460
#extension GL_EXT_nonuniform_qualifier : require

// no_api's examples/res/compute.slang in GLSL (kgp_noapi.c): a gradient
// into the backbuffer, skipping the first row and column of every
// workgroup as the original does. There the backbuffer is entry 0 of a
// second, read-write heap; KoreGP has one texture heap, so it is entry 1,
// after the texture the playground uploads. The root pointer is unused, as
// there.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform writeonly image2D targets[];

void main()
{
   ivec2 size = imageSize(targets[1]);
   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
   if (gl_LocalInvocationID.x != 0 && gl_LocalInvocationID.y != 0)
      imageStore(targets[1], p, vec4(vec2(p) / vec2(size), 0.0, 1.0));
}
