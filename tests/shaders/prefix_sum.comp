#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

// One pass of a Hillis-Steele inclusive scan:
//    dst[i] = src[i] + (i >= offset ? src[i - offset] : 0)
// log2(count) passes with offset doubling give the prefix sum. Each pass is
// its own dispatch with its own root struct, and reads what the previous
// pass wrote, so the test exercises compute -> compute barriers.

layout(local_size_x = 64) in;

layout(buffer_reference, scalar) buffer UintArray { uint v[]; };

layout(buffer_reference, scalar) readonly buffer ScanRoot {
   UintArray src;
   UintArray dst;
   uint offset;
   uint count;
};

layout(push_constant, scalar) uniform Push { ScanRoot root; };

void main()
{
   uint i = gl_GlobalInvocationID.x;
   if (i >= root.count)
      return;
   uint v = root.src.v[i];
   if (i >= root.offset)
      v += root.src.v[i - root.offset];
   root.dst.v[i] = v;
}
